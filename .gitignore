# =============================================================
# ChatBeauty — root .gitignore
# Per-folder rules live in backend/.gitignore and frontend/.gitignore.
# Anything that must bind to the root-level ml/ tree belongs HERE
# (a backend/.gitignore cannot match paths under ml/).
# =============================================================

# ── OS / editor ──
.DS_Store
**/.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── Google Drive temp artifacts ──
.tmp.drivedownload/
.tmp.driveupload/

# ── Secrets / environment (NEVER commit — keep only *.example) ──
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ──
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── ML models & datasets ──────────────────────────────────────
# Large artifacts; deployed via GCS, never committed. The .gitkeep
# files are kept so a fresh clone still has the directory skeleton.
ml/data/**
ml/model/**
# Re-include directories so git can descend to reach the keep files,
# then re-include the keep files themselves (at any depth).
!ml/data/**/
!ml/model/**/
!**/.gitkeep

# Model / checkpoint formats and datasets, wherever they appear.
*.bin
*.pt
*.ckpt
*.safetensors
*.pkl
*.jsonl

# Experiment tracking
mlruns/
mlflow.db
