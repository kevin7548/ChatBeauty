# =============================================================
# backend/.gitignore — applies only to paths under backend/.
# ML data/model and dataset rules live in the ROOT .gitignore
# (they must bind to the root-level ml/ tree, not backend/).
# =============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
wheels/

# Packaging / env
.Python
.venv/
venv/
env/
ENV/
poetry.toml

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Local SQLite
*.db
db.sqlite3
db.sqlite3-journal

# Secrets (root .gitignore also covers this; kept for safety)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
*.swo
