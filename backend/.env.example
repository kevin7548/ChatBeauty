# Backend environment — copy to .env and fill in. Do NOT commit real secrets.

# Required: Google Gemini API key (explanation service)
GEMINI_API_KEY=your-gemini-api-key

# PostgreSQL connection. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://chatbeauty:chatbeauty@localhost:5432/chatbeauty

# CORS allowlist (comma-separated). Default is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# Model paths. Defaults resolve to the GCS volume mount; override for local runs.
# BGE_MODEL_PATH=ml/model/retrieval/bge-m3-finetuned-20260202-120852
# RERANK_MODEL_PATH=ml/model/reranking/lgbm_reranker_current_features_v1.pkl

# FastAPI debug mode
DEBUG=false

# Local Postgres password used by docker-compose
DB_PASSWORD=chatbeauty
